# Copiar a .env.local y completar los valores

# LLM: OpenAI → platform.openai.com → API keys.
OPENAI_API_KEY=
# URL de la API. Vacía = https://api.openai.com/v1.
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4.1

# Supabase (base de datos + login con Google)
# Project Settings → Data API → Project URL
SUPABASE_URL=
# Project Settings → API Keys → publishable key (sb_publishable_...) o la anon key legacy.
# Es pública a propósito: la seguridad la dan las políticas RLS (backend/supabase/migrations).
SUPABASE_PUBLISHABLE_KEY=

# Las credenciales de Google (Client ID / Secret) NO van acá:
# se cargan en Supabase → Authentication → Sign In / Providers → Google.

