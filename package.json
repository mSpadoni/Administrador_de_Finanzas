{
  "name": "administrador-de-finanzas",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "test": "vitest run --project rapidos --project integracion",
    "test:rapidos": "vitest run --project rapidos",
    "test:integracion": "vitest run --project integracion",
    "test:watch": "vitest",
    "db:start": "supabase start --workdir backend",
    "db:stop": "supabase stop --workdir backend",
    "db:reset": "supabase db reset --workdir backend",
    "db:types": "supabase gen types typescript --local --schema public --workdir backend > backend/types/database.ts.nuevo && node -e \"require('fs').renameSync('backend/types/database.ts.nuevo', 'backend/types/database.ts')\" && prettier --write backend/types/database.ts",
    "format": "prettier . --write"
  },
  "dependencies": {
    "@ai-sdk/openai": "^4.0.78",
    "@ai-sdk/react": "^4.0.122",
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.117.2",
    "ai": "^7.0.118",
    "next": "^15.2.4",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "server-only": "^0.0.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.0",
    "@tailwindcss/postcss": "^4.0.14",
    "@testing-library/dom": "10.4.2",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.7",
    "@types/node": "^22.13.10",
    "@types/react": "^19.0.11",
    "@types/react-dom": "^19.0.4",
    "eslint": "^9.22.0",
    "eslint-config-next": "^15.2.4",
    "jsdom": "30.1.1",
    "prettier": "^3.9.9",
    "supabase": "^2.118.0",
    "tailwindcss": "^4.0.14",
    "typescript": "^5.8.2",
    "vitest": "^5.0.2"
  }
}
